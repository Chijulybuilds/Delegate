# ─────────────────────────────────────────────────────────────────────────────
# Delegate — environment variables.
#
# Local:  copy to `.env` at the repo root (one file for both apps).
# Vercel: add the same names in Project → Settings → Environment Variables.
#
# Everything is optional for local development: with the Supabase block empty the
# app runs a self-contained demo workspace, and payments / chat apps are simulated.
# Step-by-step instructions for every value: docs/SETUP.md and docs/INTEGRATIONS.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
# PORT=3000                       # `npm start` defaults to 3000; `npm run dev` runs the API on 4000
# PUBLIC_APP_URL=https://app.yourdomain.com   # used in links inside Slack/Teams/WhatsApp/email.
#                                 # On Vercel it falls back to your production domain automatically.
# CORS_ORIGINS=                   # only if the web app and API live on different origins

# Encrypts Slack/Teams/GitHub secrets at rest and signs Drive attestations.
# REQUIRED in production. Generate: openssl rand -hex 32   — never change it after launch.
APP_ENCRYPTION_KEY=

# Vercel only: lets webhook signatures (Stripe, Paystack, Slack, WhatsApp, GitHub) be verified.
# NODEJS_HELPERS=0

# ── Supabase (Project Settings → API Keys) ───────────────────────────────────
# When all three are set: Google sign-in + Postgres + Storage. Otherwise: demo mode.
SUPABASE_URL=
SUPABASE_ANON_KEY=                # "Publishable" / anon key — safe for the browser
SUPABASE_SERVICE_ROLE_KEY=        # "Secret" / service_role key — server only, never in a VITE_ variable
# SUPABASE_JWT_SECRET=            # optional, legacy HS256 projects only
# SUPABASE_STORAGE_BUCKET=proofs

# Demo-mode session signing (required in production only if Supabase is NOT configured)
# APP_JWT_SECRET=

# ── Platform admin console (/admin) ──────────────────────────────────────────
# Hash the password with: npm run admin:hash -- "your-long-password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=                 # openssl rand -hex 32
# ADMIN_PASSWORD=                 # dev only; refused when NODE_ENV=production

# ── Automations (escalations, playbooks, morning brief) ──────────────────────
# Protects /api/cron/tick. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>";
# Supabase pg_cron (supabase/cron.sql) sends it as "x-cron-secret".
CRON_SECRET=                      # openssl rand -hex 24
# INTERNAL_SCHEDULER=true         # run the tick in-process every minute (default: on outside production)
# SIMULATE_PROVIDERS=false        # demo deliveries/checkouts (default: on when Supabase is not set)

# ── Billing: Stripe (cards worldwide) ────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_... # Developers → Webhooks → your endpoint → Signing secret
# STRIPE_PRICE_TEAM=price_...     # recurring, monthly, per-seat price for "Delegate Team"
# TEAM_PRICE_USD=8                # shown on the Billing page; keep equal to the Stripe price

# ── Billing: Paystack (cards, bank transfer, USSD — Nigeria, Ghana, Kenya, SA) ─
# PAYSTACK_SECRET_KEY=sk_test_...  # also verifies Paystack webhooks
# PAYSTACK_PLAN_TEAM=PLN_...       # monthly plan, amount = price per seat
# TEAM_PRICE_NGN=12000             # shown on the Billing page; keep equal to the plan amount

# ── Slack app (api.slack.com/apps → Basic Information → App Credentials) ─────
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=

# ── WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp) ───────
# WHATSAPP_TOKEN=                  # permanent System User token
# WHATSAPP_PHONE_NUMBER_ID=        # WhatsApp → API Setup → Phone number ID
# WHATSAPP_BUSINESS_NUMBER=        # the same number, digits only with country code, e.g. 2348012345678
# WHATSAPP_APP_SECRET=             # App settings → Basic → App secret
# WHATSAPP_VERIFY_TOKEN=           # any random string; paste the same value in the webhook setup
# WHATSAPP_TEMPLATE_LANG=en        # language code your templates were approved in (en, en_US, …)
# WHATSAPP_GRAPH_VERSION=v21.0

# ── Google Drive proof (Google Cloud → APIs & Services) ──────────────────────
# GOOGLE_CLIENT_ID=                # OAuth Web client ID (can be the same client as sign-in)
# GOOGLE_API_KEY=                  # API key restricted to your domain + Picker API + Drive API
# GOOGLE_PROJECT_NUMBER=           # Cloud project number (Dashboard → Project info)

# ── Email: morning brief to managers (resend.com) ────────────────────────────
# RESEND_API_KEY=
# MAIL_FROM="Delegate <brief@yourdomain.com>"

# ── AI proof checks (console.anthropic.com) ──────────────────────────────────
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# ── Public business details (website footer + /privacy + /terms) ─────────────
# VITE_COMPANY_NAME="Delegate Technologies Ltd"   # legal/trading name (default: Delegate)
# VITE_SUPPORT_EMAIL=support@yourcompany.com      # an inbox you read; contact links stay hidden until set
# VITE_LEGAL_COUNTRY=Nigeria                       # whose law governs the Terms (default: Nigeria)
# GOOGLE_SITE_VERIFICATION=                        # Google Search Console "HTML tag" content value

# ── Split deploy only (web on one host, API on another) ──────────────────────
# VITE_API_URL=https://api.yourdomain.com
