# ─────────────────────────────────────────────────────────────────────────────
# Delegate — environment. Copy to `.env` at the repo root (one file for both apps).
# Leave the Supabase block empty to run the self-contained demo workspace.
# ─────────────────────────────────────────────────────────────────────────────

# Server
# PORT=3000                     # `npm start` defaults to 3000; `npm run dev` runs the API on 4000
NODE_ENV=development
# PUBLIC_APP_URL=https://app.yourdomain.com
# CORS_ORIGINS=https://yourdomain.com   # only needed if web and API are on different origins

# Supabase (Project Settings → API). When all three are set, Google sign-in + Postgres are used.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server-only secret — never expose to the browser
# SUPABASE_JWT_SECRET=          # optional: legacy HS256 projects verify tokens locally with it
# SUPABASE_STORAGE_BUCKET=proofs

# Demo-mode session signing (required in production if Supabase is not configured)
# APP_JWT_SECRET=

# Platform admin console at /admin (separate from customer sign-in)
# Generate the hash with: npm run admin:hash -- "your-long-password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=               # dev only; refused when NODE_ENV=production
ADMIN_JWT_SECRET=               # long random string, e.g. `openssl rand -hex 32`

# Optional: AI proof-of-work verification (advisory verdicts on submitted proof)
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# Optional: 8:00 AM Standup-in-a-Box emails via Resend
# RESEND_API_KEY=
# MAIL_FROM="Delegate <standup@yourdomain.com>"
# CRON_SECRET=                  # POST /api/cron/standup with header x-cron-secret: <value>

# Optional: split deploy (web on Vercel, API elsewhere) — the web build calls this origin
# VITE_API_URL=https://api.yourdomain.com
